generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum ReadingEventType {
  VIEWED
  INTERESTED
  FINISHED
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  image                   String?
  passwordHash            String?
  role                    UserRole                 @default(USER)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  accounts                Account[]
  sessions                Session[]
  reviews                 Review[]
  favorites               Favorite[]
  readingHistory          ReadingHistory[]
  recommendationSnapshots RecommendationSnapshot[]
}

model Book {
  id               String               @id @default(cuid())
  title            String
  subtitle         String?
  originalTitle    String?
  slug             String               @unique
  description      String
  coverImage       String?
  year             Int
  isbn             String?              @unique
  isbn10           String?              @unique
  isbn13           String?              @unique
  publisher        String?
  edition          String?
  language         String
  pages            Int
  ratingAverage    Float?
  ratingsCount     Int?
  sourcePrimary    String?
  sourceExternalId String?
  isFeatured       Boolean              @default(false)
  isPublished      Boolean              @default(true)
  publishedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  coverAssets      BookCoverAsset[]
  sourceRecords    BookSourceRecord[]
  authors          BookAuthor[]
  genres           BookGenre[]
  reviews          Review[]
  favorites        Favorite[]
  readingHistory   ReadingHistory[]
  recommendedIn    RecommendationItem[]
}

model BookSourceRecord {
  id             String   @id @default(cuid())
  bookId         String
  provider       String
  externalId     String
  sourceUrl      String?
  rawChecksum    String?
  rawPayload     Json?
  lastImportedAt DateTime @default(now())
  book           Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
}

model BookCoverAsset {
  id            String   @id @default(cuid())
  bookId        String
  originalUrl   String
  cachedPath    String
  publicUrl     String
  width         Int?
  height        Int?
  dominantColor String?
  blurDataUrl   String?
  status        String   @default("ready")
  lastFetchedAt DateTime @default(now())
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Author {
  id    String       @id @default(cuid())
  name  String
  slug  String       @unique
  books BookAuthor[]
}

model Genre {
  id    String      @id @default(cuid())
  name  String
  slug  String      @unique
  books BookGenre[]
}

model BookAuthor {
  bookId   String
  authorId String
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
}

model BookGenre {
  bookId  String
  genreId String
  book    Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([bookId, genreId])
}

model Review {
  id        String       @id @default(cuid())
  rating    Int
  content   String
  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  userId    String
  bookId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  bookId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model ReadingHistory {
  id        String           @id @default(cuid())
  eventType ReadingEventType
  createdAt DateTime         @default(now())
  userId    String
  bookId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model RecommendationSnapshot {
  id            String               @id @default(cuid())
  summary       String
  createdAt     DateTime             @default(now())
  provider      String
  strategy      String               @default("fallback")
  status        String               @default("ready")
  triggerSource String?
  contextHash   String?
  insights      Json?
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         RecommendationItem[]
}

model RecommendationItem {
  id         String                 @id @default(cuid())
  reason     String
  badge      String?
  score      Float?
  position   Int
  snapshotId String
  bookId     String
  snapshot   RecommendationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  book       Book                   @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
