generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

enum VerificationPurpose {
  SIGN_UP
  PASSWORD_RESET
}

enum ReadingEventType {
  VIEWED
  INTERESTED
  FINISHED
}

enum BookContentSourceType {
  PDF
  EXTERNAL_LINK
}

enum BookContentStatus {
  READY
  PROCESSING
  FAILED
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  image                   String?
  passwordHash            String?
  role                    UserRole                 @default(USER)
  bannedUntil             DateTime?
  bannedPermanently       Boolean                  @default(false)
  banReason               String?
  lastLoginAt             DateTime?
  authVersion             Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  accounts                Account[]
  sessions                Session[]
  reviews                 Review[]
  favorites               Favorite[]
  readingHistory          ReadingHistory[]
  readingProgress         ReadingProgress[]
  recommendationSnapshots RecommendationSnapshot[]
  uploadedBookContents    BookContent[]            @relation("UploadedBookContents")
  adminAuditLogs          AdminAuditLog[]           @relation("AdminAuditActor")
  notifications           Notification[]
  readerAnnotations       ReaderAnnotation[]
  avatarBlob              UserAvatar?
  readerAiConversations   ReaderAiConversation[]
}

model Book {
  id               String               @id @default(cuid())
  title            String
  subtitle         String?
  originalTitle    String?
  slug             String               @unique
  description      String
  coverImage       String?
  year             Int
  isbn             String?              @unique
  isbn10           String?              @unique
  isbn13           String?              @unique
  publisher        String?
  edition          String?
  language         String
  pages            Int
  ratingAverage    Float?
  ratingsCount     Int?
  sourcePrimary    String?
  sourceExternalId String?
  isFeatured       Boolean              @default(false)
  isPublished      Boolean              @default(true)
  publishedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  coverAssets      BookCoverAsset[]
  sourceRecords    BookSourceRecord[]
  authors          BookAuthor[]
  genres           BookGenre[]
  reviews          Review[]
  favorites        Favorite[]
  readingHistory   ReadingHistory[]
  readingProgress  ReadingProgress[]
  recommendedIn    RecommendationItem[]
  contents         BookContent[]
  readerAnnotations ReaderAnnotation[]
  readerAiConversations ReaderAiConversation[]
}

model BookSourceRecord {
  id             String   @id @default(cuid())
  bookId         String
  provider       String
  externalId     String
  sourceUrl      String?
  rawChecksum    String?
  rawPayload     Json?
  lastImportedAt DateTime @default(now())
  book           Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
}

model BookCoverAsset {
  id            String   @id @default(cuid())
  bookId        String
  originalUrl   String
  cachedPath    String
  publicUrl     String
  width         Int?
  height        Int?
  dominantColor String?
  blurDataUrl   String?
  status        String   @default("ready")
  lastFetchedAt DateTime @default(now())
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Author {
  id    String       @id @default(cuid())
  name  String
  slug  String       @unique
  books BookAuthor[]
}

model Genre {
  id    String      @id @default(cuid())
  name  String
  slug  String      @unique
  books BookGenre[]
}

model BookAuthor {
  bookId   String
  authorId String
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
}

model BookGenre {
  bookId  String
  genreId String
  book    Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([bookId, genreId])
}

model Review {
  id        String       @id @default(cuid())
  rating    Int
  content   String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  userId    String
  bookId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, bookId, createdAt])
  @@index([bookId, status, createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  bookId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model BookContent {
  id               String                @id @default(cuid())
  bookId           String
  sourceType       BookContentSourceType
  storagePath      String?
  publicUrl        String?
  externalUrl      String?
  fileName         String?
  mimeType         String?
  uploadedByUserId String?
  isPrimary        Boolean               @default(false)
  status           BookContentStatus     @default(READY)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  book             Book                  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  uploadedByUser   User?                 @relation("UploadedBookContents", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  readingProgress  ReadingProgress[]
  readerAnnotations ReaderAnnotation[]
  readerAiConversations ReaderAiConversation[]

  @@index([bookId, isPrimary])
}

model ReadingHistory {
  id        String           @id @default(cuid())
  eventType ReadingEventType
  createdAt DateTime         @default(now())
  userId    String
  bookId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model ReadingProgress {
  id              String      @id @default(cuid())
  userId          String
  bookId          String
  contentId       String?
  progressPercent Float       @default(0)
  lastPage        Int         @default(0)
  totalPages      Int         @default(0)
  completedAt     DateTime?
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  book            Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  content         BookContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@unique([userId, bookId])
}

model RecommendationSnapshot {
  id            String               @id @default(cuid())
  summary       String
  createdAt     DateTime             @default(now())
  provider      String
  strategy      String               @default("fallback")
  status        String               @default("ready")
  triggerSource String?
  contextHash   String?
  insights      Json?
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         RecommendationItem[]
}

model RecommendationItem {
  id         String                 @id @default(cuid())
  reason     String
  badge      String?
  score      Float?
  position   Int
  snapshotId String
  bookId     String
  snapshot   RecommendationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  book       Book                   @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


model EmailVerificationCode {
  id         String              @id @default(cuid())
  email      String
  purpose    VerificationPurpose
  codeHash   String
  expiresAt  DateTime
  lastSentAt DateTime
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([email, purpose])
  @@index([expiresAt])
}

model AuthRateLimit {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  adminUser   User?    @relation("AdminAuditActor", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model ReaderAnnotation {
  id        String       @id @default(cuid())
  userId    String
  bookId    String
  contentId String?
  page      Int
  quote     String?      @db.Text
  note      String?      @db.Text
  rects     Json?
  color     String       @default("yellow")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  content   BookContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([userId, bookId, page])
  @@index([bookId, page])
}

model UserAvatar {
  userId    String   @id
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model ReaderAiConversation {
  id        String            @id @default(cuid())
  userId    String
  bookId    String
  contentId String?
  scope     String
  page      Int?
  title     String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  content   BookContent?      @relation(fields: [contentId], references: [id], onDelete: SetNull)
  messages  ReaderAiMessage[]

  @@index([userId, bookId, updatedAt])
  @@index([userId, bookId, scope, page])
}

model ReaderAiMessage {
  id             String               @id @default(cuid())
  conversationId String
  role           String
  content        String               @db.Text
  createdAt      DateTime             @default(now())
  conversation   ReaderAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
