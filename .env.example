DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_library"
AUTH_SECRET="replace-with-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
POSTGRES_DB="smart_library"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
AI_PROVIDER=fallback
OPENAI_RECOMMENDATION_MODEL=gpt-4o-mini
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
VERCEL_PROJECT_PRODUCTION_URL=

# Email verification (Gmail example via Nodemailer)
SMTP_SERVICE=Gmail
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public URL used by QR codes for phone 3D/AR testing.
# For same-Wi-Fi 3D fallback you may use http://192.168.x.x:3000.
# For WebXR immersive-ar/camera use an HTTPS URL (Vercel/ngrok/Cloudflare Tunnel).
AR_PUBLIC_BASE_URL=
NEXT_PUBLIC_AR_BASE_URL=

# Local Reader AI / OCR backend (used when OPENAI_API_KEY is empty or unavailable)
# Default Windows Hugging Face cache requested by this project:
LOCAL_AI_HF_HOME="D:\\AIModels\\huggingface\\hub"
# Optional: pin one compatible cached model snapshot instead of auto-discovery.
LOCAL_AI_MODEL_PATH=
# On NVIDIA GPUs, REQUIRE bitsandbytes 4-bit NF4. If 4-bit is unavailable,
# backend will NOT silently load fp16/bf16 into VRAM; it falls back safely.
LOCAL_AI_4BIT=1
# Allow up to two simultaneous Reader AI generations sharing one resident model.
LOCAL_AI_CONCURRENCY=2
# Keep KV cache bounded on 8 GB laptop GPUs.
LOCAL_AI_MAX_INPUT_TOKENS=4096
LOCAL_AI_MAX_NEW_TOKENS=640
# Python executable used by local AI and traditional Tesseract OCR helpers.
PYTHON_BIN=python
# OCR pipeline: native PDF text layer -> optional formula-aware Pix2Text -> Tesseract fallback.
READER_OCR_PROVIDER=auto
OPENAI_READER_VISION_MODEL=gpt-4.1-mini
OPENAI_READER_IMAGE_MODEL=gpt-image-1-mini
OCR_LANGUAGES=rus+eng+vie
# Optional absolute path to tesseract.exe when it is not in PATH.
TESSERACT_CMD=
# Formula-aware OCR emits LaTeX ($...$ / $$...$$). If Pix2Text is not
# installed or cannot load, the worker automatically falls back to Tesseract.
MATH_OCR_ENABLED=1
# Keep math OCR on CPU by default so it does not compete with Reader AI for VRAM.
# Change to cuda only when the machine has enough GPU memory.
MATH_OCR_DEVICE=cpu
# First model initialization can be slower than a normal Tesseract request.
OCR_TIMEOUT_MS=300000
