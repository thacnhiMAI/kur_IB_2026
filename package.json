{
  "name": "smart-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:agent": "node scripts/dev-agent.mjs",
    "agent:local-site": "powershell.exe -NoProfile -STA -File scripts/local-agent.ps1 -LocalSite",
    "agent:workers": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/agent-workers.mjs",
    "test:agent-load": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/load-reader-queue.mts",
    "agent:worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/local-agent.ts --headless",
    "agent:local": "powershell.exe -NoProfile -STA -File scripts/local-agent.ps1",
    "setup": "node scripts/setup-full.mjs",
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:phase-a": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_PORT='3001'; npx playwright test tests/e2e/smoke.spec.ts tests/e2e/catalog-premium.spec.ts\"",
    "test:e2e:phase-b": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_HOST='127.0.0.1'; $env:PLAYWRIGHT_PORT='3001'; $env:NEXTAUTH_URL='http://127.0.0.1:3001'; npx playwright test tests/e2e/recommendations-phase-b.spec.ts\"",
    "test:e2e:phase-c": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_HOST='127.0.0.1'; $env:PLAYWRIGHT_PORT='3001'; $env:NEXTAUTH_URL='http://127.0.0.1:3001'; npx playwright test tests/e2e/ar-preview-phase-c.spec.ts\"",
    "test:e2e:phase-d": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_HOST='127.0.0.1'; $env:PLAYWRIGHT_PORT='3001'; $env:NEXTAUTH_URL='http://127.0.0.1:3001'; $env:PLAYWRIGHT_PRODUCTION='1'; npx playwright test tests/e2e/voice-pwa-phase-d.spec.ts\"",
    "test:e2e:phase-e": "powershell -NoProfile -Command \"$env:PLAYWRIGHT_HOST='127.0.0.1'; $env:PLAYWRIGHT_PORT='3001'; $env:NEXTAUTH_URL='http://127.0.0.1:3001'; npx playwright test tests/e2e/phase-e-public-routes.spec.ts\"",
    "test:e2e:phase-a:isolated": "npm run test:e2e:phase-a",
    "audit:phase-e:routes": "tsx scripts/phase-e/route-baseline.ts",
    "check:env:phase-e": "tsx scripts/phase-e/check-env.ts",
    "verify:phase-a": "npm run lint && npm run test && npm run build",
    "verify:phase-b": "npm run lint && npm run test && npm run build",
    "verify:phase-c": "npm run lint && npm run test && npm run build",
    "verify:phase-d": "npm run lint && npm run test && npm run build",
    "verify:phase-e": "npm run lint && npm run test && npm run build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "import:books": "tsx scripts/import-books.mjs",
    "migrate:reading-storage": "tsx scripts/migrate-reading-storage.ts",
    "verify:reader-v14": "node scripts/verify-reader-v14.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.15.0",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.2",
    "jsqr": "^1.4.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^12.3.0",
    "next": "^15.5.3",
    "next-auth": "^5.0.0-beta.29",
    "nodemailer": "^8.0.11",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^6.3.289",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-pageflip": "^2.0.3",
    "react-pdf": "^11.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.4",
    "three": "^0.187.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^6.4.17",
    "@types/page-flip": "^2.0.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.187.0",
    "@types/web-push": "^3.6.4",
    "@types/webxr": "^0.5.24",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prisma": "^6.15.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
