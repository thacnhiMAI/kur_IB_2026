<Window xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Title="Agent Studio | Office" Width="1240" Height="820" MinWidth="1000" MinHeight="660" Background="#E9DFFA" Foreground="#27213C" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#EEE8FC"/><Setter Property="Foreground" Value="#27213C"/>
      <Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="24,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <Border DockPanel.Dock="Right" Background="#F6F0FF" CornerRadius="5" Padding="13,7" VerticalAlignment="Center">
        <TextBlock Name="State" Text="Ready" MaxWidth="235" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </Border>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
        <TextBlock Text="Model" FontWeight="SemiBold" Margin="0,0,7,0" VerticalAlignment="Center"/>
        <ComboBox Name="ModelChoice" Width="230" DisplayMemberPath="Label" SelectedValuePath="Id" IsEnabled="False" AutomationProperties.Name="Model for next task"/>
        <Button Name="ReloadModels" Content="↻" Margin="5,0,0,0" Padding="8,3" ToolTip="Reload available models" AutomationProperties.Name="Reload available models"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock FontSize="30" FontWeight="Black"><Run Foreground="#7851E3">Agent</Run><Run Foreground="#E34F92"> Studio</Run></TextBlock>
        <ToggleButton Name="ShowHistory" Content="History" IsChecked="True" Margin="14,0,5,0" Padding="8,5" VerticalAlignment="Center" AutomationProperties.Name="Show session history"/>
        <ToggleButton Name="ShowDetails" Content="Details" IsChecked="True" Padding="8,5" VerticalAlignment="Center" AutomationProperties.Name="Show agent details"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="HistoryColumn" Width="183" MinWidth="140"/><ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition x:Name="DetailsColumn" Width="290" MinWidth="205"/></Grid.ColumnDefinitions>
      <Border Name="HistoryPanel" Background="#FFFCFF" BorderBrush="#DED3F3" BorderThickness="1" CornerRadius="16" Padding="10" Margin="0,0,12,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
            <TextBlock Text="Session history" FontWeight="SemiBold"/>
            <Button Name="LiveRun" Content="Latest run" Margin="0,7,0,0"/>
          </StackPanel>
          <ListBox Name="History" AutomationProperties.Name="Runs in this session" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Background="#F3EBFF" CornerRadius="16" Padding="14" Margin="0,0,14,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="3,0,3,8">
            <TextBlock Name="ProgressText" DockPanel.Dock="Right" Text="No active run" Foreground="#665A81"/>
            <TextBlock Text="Team floor" Foreground="#34294C" FontWeight="SemiBold"/>
          </DockPanel>
          <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="2,0,2,7">
              <UniformGrid Rows="1" Columns="3">
                <Button Name="FlowPlan" Content="Plan  →" Margin="0,0,5,0"/>
                <Button Name="FlowWork" Content="Agents  →" Margin="0,0,5,0"/>
                <Button Name="FlowFinal" Content="Delivery"/>
              </UniformGrid>
              <TextBlock Name="FlowSummary" Foreground="#574771" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Viewbox Grid.Row="1" Stretch="Uniform"><Canvas Name="Graph" Width="720" Height="448" ClipToBounds="True"/></Viewbox>
          </Grid>
          <StackPanel Grid.Row="2" Margin="3,8,0,0"><UniformGrid Name="CrewDock" Rows="1" Margin="0,0,0,7"/><StackPanel Orientation="Horizontal">
            <TextBlock Text="●  Working" Foreground="#926018" Margin="0,0,18,0"/>
            <TextBlock Text="●  Complete" Foreground="#267858" Margin="0,0,18,0"/>
            <TextBlock Text="●  Needs attention" Foreground="#BA405F"/>
          </StackPanel></StackPanel>
        </Grid>
      </Border>
      <Border Name="DetailsPanel" Grid.Column="2" Background="#FFFCFF" BorderBrush="#DED3F3" BorderThickness="1" CornerRadius="16" Padding="15">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Name="PreviousDesk" Content="‹" ToolTip="Previous desk" AutomationProperties.Name="Previous desk" Margin="0,0,4,0"/>
              <Button Name="NextDesk" Content="›" ToolTip="Next desk" AutomationProperties.Name="Next desk"/>
            </StackPanel>
            <TextBlock Name="DeskTitle" Text="Coordinator" FontFamily="Georgia" FontSize="20" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock Name="DeskMeta" Grid.Row="1" Margin="1,8,0,10" Foreground="#645675" TextWrapping="Wrap"/>
          <TextBox Name="Details" Grid.Row="2" Background="Transparent" Foreground="#27213C" BorderThickness="0" Padding="0,5" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="13"/>
        </Grid>
      </Border>
      <GridSplitter Name="HistorySplitter" Grid.Column="0" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" ShowsPreview="True" AutomationProperties.Name="Resize session history"/>
      <GridSplitter Name="DetailsSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" ShowsPreview="True" AutomationProperties.Name="Resize agent details"/>
    </Grid>
    <Border Grid.Row="2" Background="#FFFCFF" BorderBrush="#DED3F3" BorderThickness="1" CornerRadius="16" Padding="13" Margin="0,14,0,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Width="137">
          <TextBlock Text="Parallel requests" FontSize="12"/>
          <ComboBox Name="ParallelLimit" Margin="0,4,0,6" AutomationProperties.Name="Parallel requests"/>
          <TextBlock Text="Subagent limit" FontSize="12"/>
          <ComboBox Name="Limit" Margin="0,4,0,6" AutomationProperties.Name="Subagent limit"/>
          <Button Name="Run" Content="Start task" Background="#7546DC" Foreground="White"/>
          <Button Name="Cancel" Content="Cancel run" Margin="0,4,0,0" IsEnabled="False"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Task brief" FontWeight="SemiBold" Margin="0,0,0,5"/>
          <TextBox Name="Prompt" Height="82" MaxLength="8000" Padding="8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F7F2FF" BorderBrush="#DDD2F0" AutomationProperties.Name="Task brief"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
